#include "dxil_cfg_reader.h"

// Direct includes from dxil-spirv
#include "dxc/DXIL/DxilModule.h"
#include "dxc/DXIL/DxilConstants.h"
#include "llvm/IR/Function.h"
#include "llvm/IR/BasicBlock.h"
#include "llvm/IR/Instructions.h"

#include <cstring>
#include <cstdlib>
#include <unordered_map>
#include <vector>

using namespace llvm;
using namespace hlsl;

extern "C" {

dxil_cfg_construct_t* dxil_extract_cfg(void* dxil_module_ptr) {
    // Validate input
    if (!dxil_module_ptr) {
        auto* cfg = new dxil_cfg_construct_t();
        memset(cfg, 0, sizeof(*cfg));
        snprintf(cfg->error_message, sizeof(cfg->error_message),
                 "Null DxilModule pointer");
        return cfg;
    }
    
    auto* dxil_module = static_cast<DxilModule*>(dxil_module_ptr);
    auto* cfg = new dxil_cfg_construct_t();
    memset(cfg, 0, sizeof(*cfg));
    
    // Get entry function
    Function* entryFunc = dxil_module->GetEntryFunction();
    if (!entryFunc) {
        snprintf(cfg->error_message, sizeof(cfg->error_message),
                 "No entry function found in DxilModule");
        return cfg;
    }
    
    // Map basic blocks to indices
    std::unordered_map<const BasicBlock*, uint32_t> blockIdx;
    uint32_t idx = 0;
    for (const auto& bb : *entryFunc) {
        blockIdx[&bb] = idx++;
    }
    
    if (blockIdx.empty()) {
        snprintf(cfg->error_message, sizeof(cfg->error_message),
                 "Entry function has no basic blocks");
        return cfg;
    }
    
    // Get CFG hints from dxil-spirv
    const auto& hints = dxil_module->GetControlFlowHints(entryFunc);
    
    // Validate hints consistency
    if (!hints.headers.empty() && hints.headers.size() != blockIdx.size()) {
        snprintf(cfg->error_message, sizeof(cfg->error_message),
                 "Warning: Hint count (%zu) != block count (%zu)",
                 hints.headers.size(), blockIdx.size());
        // Continue anyway - use what we have
    }
    
    // Allocate and initialize blocks
    cfg->num_blocks = (uint32_t)blockIdx.size();
    cfg->blocks = (dxil_cfg_block_t*)calloc(cfg->num_blocks, sizeof(dxil_cfg_block_t));
    if (!cfg->blocks) {
        snprintf(cfg->error_message, sizeof(cfg->error_message),
                 "Failed to allocate block array (%u blocks)", cfg->num_blocks);
        delete cfg;
        return nullptr;
    }
    cfg->entry_block = blockIdx[&entryFunc->getEntryBlock()];
    
    // First pass: Fill block info and successors
    for (const auto& bb : *entryFunc) {
        uint32_t i = blockIdx[&bb];
        cfg->blocks[i].index = i;
        
        // Copy CFG hints from dxil-spirv
        if (i < hints.headers.size()) {
            cfg->blocks[i].header = hints.headers[i];
            cfg->blocks[i].merge = hints.merges[i];
            cfg->blocks[i].continue_block = hints.continues[i];
            cfg->blocks[i].hint = (uint32_t)hints.hints[i];
        } else {
            // Default values for blocks without hints
            cfg->blocks[i].header = 0;
            cfg->blocks[i].merge = 0;
            cfg->blocks[i].continue_block = 0;
            cfg->blocks[i].hint = 0;
        }
        
        // Add successors from terminator instruction
        const auto* term = bb.getTerminator();
        if (term) {
            cfg->blocks[i].num_successors = term->getNumSuccessors();
            for (unsigned s = 0; s < cfg->blocks[i].num_successors && s < 8; s++) {
                auto it = blockIdx.find(term->getSuccessor(s));
                if (it != blockIdx.end()) {
                    cfg->blocks[i].successors[s] = it->second;
                } else {
                    cfg->blocks[i].successors[s] = 0;  // Invalid, but safe
                }
            }
        }
    }
    
    // Second pass: Build predecessor lists
    for (uint32_t i = 0; i < cfg->num_blocks; i++) {
        cfg->blocks[i].num_predecessors = 0;
        for (uint32_t s = 0; s < cfg->blocks[i].num_successors; s++) {
            uint32_t succ = cfg->blocks[i].successors[s];
            if (succ < cfg->num_blocks) {
                uint32_t pred_idx = cfg->blocks[succ].num_predecessors;
                if (pred_idx < 8) {
                    cfg->blocks[succ].predecessors[pred_idx] = i;
                    cfg->blocks[succ].num_predecessors++;
                }
            }
        }
    }
    
    // Success!
    snprintf(cfg->error_message, sizeof(cfg->error_message),
             "CFG extracted: %u blocks, entry: %u, hints: %zu, edges: %zu",
             cfg->num_blocks, cfg->entry_block, hints.headers.size(),
             [&cfg]() {
                 size_t total = 0;
                 for (uint32_t i = 0; i < cfg->num_blocks; i++)
                     total += cfg->blocks[i].num_successors;
                 return total;
             }());
    
    return cfg;
}

void dxil_free_cfg(dxil_cfg_construct_t* cfg) {
    if (cfg) {
        if (cfg->blocks) {
            free(cfg->blocks);
            cfg->blocks = nullptr;
        }
        delete cfg;
    }
}

} // extern "C"